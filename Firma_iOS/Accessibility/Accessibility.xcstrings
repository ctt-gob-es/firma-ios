    "dni_scan_view.image.label" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Col·loca el dispositiu mòbil alineat amb el xip del DNI, de manera que el document sobresurti lleugerament per la part superior del telèfon per facilitar la lectura del xip"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Place the mobile device aligned with the DNI chip, so that the document slightly protrudes from the top of the phone to facilitate chip reading"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca el dispositivo móvil alineado con el chip del DNI, de forma que el documento sobresalga ligeramente por la parte superior del teléfono para facilitar la lectura del chip"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarri gailu mugikorra NAN txartelaren txiparekin lerrokatuta, dokumentua telefonoaren goiko aldetik pixka bat irtenda gera dadin, txiparen irakurketa errazteko"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca o dispositivo móbil aliñado co chip do DNI, de forma que o documento sobresaía lixeiramente pola parte superior do teléfono para facilitar a lectura do chip"
          }
        },
        "va" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Col·loca el dispositiu mòbil alineat amb el xip del DNI, de manera que el document sobresurti lleugerament per la part superior del telèfon per facilitar la lectura del xip"
          }
        }
      }
    },
